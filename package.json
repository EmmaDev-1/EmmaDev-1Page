{
  "name": "emmadev-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio of Emmanuel — FrontEnd Engineer. Next.js + EmmaDev Design System.",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.json src scripts && eslint",
    "lint:adherence": "eslint --config eslint.adherence.config.mjs src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "media:build": "tsx scripts/media-optimize.ts",
    "ds:sync": "tsx scripts/ds-sync.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:adherence && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "ffmpeg-static": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.6",
    "oxlint": "^1.24.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --config oxlint.json --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
